# Copy to .env and fill in. Never commit the real .env.
# Model: "mock" (offline, no cost) or "meta" (Meta Model API, Muse Spark)
WFAGENT_LLM=mock
MODEL_API_KEY=
WFAGENT_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
# Catalogue: "demo" (synthetic, offline) or "wfarhali" (live Wfarhali search API, real products and DZD estimates)
WFAGENT_CATALOGUE=demo
WFARHALI_BASE_URL=https://wfarhali.com
# Speech to text: "mock" or "meta" (Muse Voice Transcribe)
WFAGENT_STT=mock
# Locating the product in a photo: "mock" or "meta" (SAM 3.1)
WFAGENT_SEGMENT=mock
